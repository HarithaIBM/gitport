diff --git a/run-command.c b/run-command.c
index e70a8a387b..6f14a4e1b6 100644
--- a/run-command.c
+++ b/run-command.c
@@ -18,6 +18,10 @@
 #include "packfile.h"
 #include "compat/nonblock.h"
 
+#ifdef __MVS__
+#include <zos.h>
+#endif
+
 void child_process_init(struct child_process *child)
 {
 	struct child_process blank = CHILD_PROCESS_INIT;
@@ -679,7 +683,7 @@ int start_command(struct child_process *cmd)
 	int need_in, need_out, need_err;
 	int fdin[2], fdout[2], fderr[2];
 	int failed_errno;
-	const char *str;
+	const char *str = NULL;
 
 	/*
 	 * In case of errors we must keep the promise to close FDs
@@ -695,6 +699,10 @@ int start_command(struct child_process *cmd)
 			str = "standard input";
 			goto fail_pipe;
 		}
+#ifdef __MVS__
+		/* __disableautocvt(fdin[0]); */
+		/* __disableautocvt(fdin[1]); */
+#endif
 		cmd->in = fdin[1];
 	}
 
@@ -711,6 +719,10 @@ int start_command(struct child_process *cmd)
 			str = "standard output";
 			goto fail_pipe;
 		}
+#ifdef __MVS__
+		/* __disableautocvt(fdout[0]); */
+		/* __disableautocvt(fdout[1]); */
+#endif
 		cmd->out = fdout[0];
 	}
 
@@ -727,13 +739,12 @@ int start_command(struct child_process *cmd)
 			else if (cmd->out)
 				close(cmd->out);
 			str = "standard error";
-fail_pipe:
-			error("cannot create %s pipe for %s: %s",
-				str, cmd->args.v[0], strerror(failed_errno));
-			child_process_clear(cmd);
-			errno = failed_errno;
-			return -1;
+			goto fail_pipe;
 		}
+#ifdef __MVS__
+		/* __disableautocvt(fderr[0]); */
+		/* __disableautocvt(fderr[1]); */
+#endif
 		cmd->err = fderr[0];
 	}
 
@@ -965,6 +976,10 @@ int start_command(struct child_process *cmd)
 
 	if (cmd->pid < 0) {
 		trace2_child_exit(cmd, -1);
+fail_pipe:
+		if (str)
+			error("cannot create %s pipe for %s: %s",
+				str, cmd->args.v[0], strerror(failed_errno));
 
 		if (need_in)
 			close_pair(fdin);
@@ -1173,6 +1188,10 @@ int start_async(struct async *async)
 				close(async->out);
 			return error_errno("cannot create pipe");
 		}
+#ifdef __MVS__
+		/* __disableautocvt(fdin[0]); */
+		/* __disableautocvt(fdin[1]); */
+#endif
 		async->in = fdin[1];
 	}
 
@@ -1185,6 +1204,10 @@ int start_async(struct async *async)
 				close(async->in);
 			return error_errno("cannot create pipe");
 		}
+#ifdef __MVS__
+		/* __disableautocvt(fdout[0]); */
+		/* __disableautocvt(fdout[1]); */
+#endif
 		async->out = fdout[0];
 	}
 
