--- a/diff.c
+++ b/diff.c
@@ -5848,10 +5848,24 @@ static enum parse_opt_result diff_opt_output(struct parse_opt_ctx_t *ctx,
 	BUG_ON_OPT_NEG(unset);
 	path = prefix_filename(ctx->prefix, arg);
 	options->file = xfopen(path, "w");
 	options->close_file = 1;
+
+#ifdef __MVS__
+	if (options->file) {
+		int fd = fileno(options->file);
+		if (fd >= 0) {
+			__setfdbinary(fd);
+			__disableautocvt(fd);
+		}
+	}
+	/* Save path for later tagging */
+	options->output_path = xstrdup(arg);
+#endif
+
 	if (options->use_color != GIT_COLOR_ALWAYS)
 		options->use_color = GIT_COLOR_NEVER;
 	free(path);
 	return 0;
 }
@@ -7177,10 +7191,24 @@ static void diff_free_file(struct diff_options *options)
 {
 	if (options->close_file && options->file) {
+#ifdef __MVS__
+		/* Tag file before closing */
+		if (options->output_path) {
+			int fd = fileno(options->file);
+			if (fd >= 0) {
+				struct index_state *istate = the_repository->index;
+				tag_file_as_working_tree_encoding(istate,
+								 options->output_path,
+								 fd, 1);
+			}
+			free(options->output_path);
+			options->output_path = NULL;
+		}
+#endif
 		fclose(options->file);
 		options->file = NULL;
 	}
 }
